# PostHog(計測)。未設定の場合、計測は無効化されアプリは通常動作する
EXPO_PUBLIC_POSTHOG_API_KEY=
# 例: https://us.i.posthog.com または https://eu.i.posthog.com
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Android本番ビルド用のGoogle Maps APIキー(Expo Goでの開発では不要)
GOOGLE_MAPS_ANDROID_API_KEY=

# 車旅のしおりAPI(/api/v1/spots)の固定APIキー。tns-web側の SPOTS_API_KEY と同じ値にする。
# バンドルに埋め込まれ抽出可能なため本物の認証ではなく匿名アクセス除け(段差)。
# 未設定なら x-api-key ヘッダー無しで送信する(サーバーが未設定なら素通し)。
# 本番ビルドでは EAS secret / EAS環境変数として設定し、この値はコミットしない。
EXPO_PUBLIC_SPOTS_API_KEY=
